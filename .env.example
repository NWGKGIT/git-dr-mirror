# git-dr-mirror configuration
#
# Copy this file to `.env` and fill in the required values:
#
#     cp .env.example .env
#     chmod 600 .env      # keep your tokens private
#
# Every setting can also be provided as a real environment variable
# (real environment variables take precedence over `.env`).

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# GitHub personal access token.
# Create: https://github.com/settings/personal-access-tokens/new (Fine-grained)
#      or https://github.com/settings/tokens/new (Classic)
# Needs READ access to your repositories (public and private).
#   - Fine-grained token: "Contents: read-only" + "Metadata: read-only"
#     on all repositories you want backed up.
#   - Classic token: the `repo` scope.
# TIP: Set expiration to 1 year (or "No expiration") to prevent backups from stopping.
GITHUB_TOKEN=

# GitLab personal access token.
# Create: https://gitlab.com/-/user_settings/personal_access_tokens
#   - Token type: Legacy Token (not Fine-grained, as they cannot create projects)
#   - Scopes: `api` (to create backup projects) and `write_repository` (to push)
# Delete permissions are NOT required — this tool never deletes anything.
# TIP: Set expiration to 1 year (or "No expiration") to prevent backups from stopping.
GITLAB_TOKEN=

# GitLab group where backups are created, e.g. "my-github-backup".
# Create group: https://gitlab.com/groups/new#create-group
# Subgroups are supported: "my-team/github-backup".
# The group itself must already exist; projects inside it are created
# automatically.
GITLAB_GROUP=

# ---------------------------------------------------------------------------
# Optional — hosts
# ---------------------------------------------------------------------------

# GitLab instance base URL. Change for self-hosted GitLab.
#GITLAB_URL=https://gitlab.com

# GitHub API base URL. Change for GitHub Enterprise
# (e.g. https://github.example.com/api/v3).
#GITHUB_API_URL=https://api.github.com

# ---------------------------------------------------------------------------
# Optional — scope
# ---------------------------------------------------------------------------

# Which repositories to back up, as a GitHub "affiliation" filter.
# Comma-separated set of: owner, collaborator, organization_member.
# Default backs up only repositories you own.
#GITHUB_AFFILIATION=owner

# Also mirror repositories that are forks of other projects.
#INCLUDE_FORKS=false

# Skip repositories whose name matches any of these comma-separated
# glob patterns, e.g. "scratch-*,*-archive,tmp".
#EXCLUDE_REPOS=

# Visibility of the GitLab projects this tool creates.
# One of: private, internal, public. Backups should normally stay private.
#GITLAB_VISIBILITY=private

# ---------------------------------------------------------------------------
# Optional — paths
# ---------------------------------------------------------------------------

# Directory holding the local bare-mirror cache. Created if missing.
#MIRROR_DIR=~/github-backup

# ---------------------------------------------------------------------------
# Optional — fault tolerance
# ---------------------------------------------------------------------------

# Per-HTTP-request timeout in seconds.
#HTTP_TIMEOUT=30

# Number of retries (with exponential backoff) for transient API failures.
#HTTP_RETRIES=3

# Timeout in seconds for a single git operation (clone/fetch/push).
# Raise this if you have very large repositories or a slow connection.
#GIT_TIMEOUT=3600

# Logging verbosity: DEBUG, INFO, WARNING, ERROR.
#LOG_LEVEL=INFO

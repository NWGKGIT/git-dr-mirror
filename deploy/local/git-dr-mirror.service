# git-dr-mirror — systemd USER service (local workstation / laptop)
#
# Install (see README for details):
#   1. Edit WorkingDirectory/ExecStart below to point at your clone.
#   2. cp deploy/local/git-dr-mirror.{service,timer} ~/.config/systemd/user/
#   3. systemctl --user daemon-reload
#   4. systemctl --user enable --now git-dr-mirror.timer
#
# Run once manually:      systemctl --user start git-dr-mirror.service
# Watch logs:             journalctl --user -u git-dr-mirror -f

[Unit]
Description=GitHub -> GitLab disaster-recovery mirror
Documentation=https://github.com/OWNER/git-dr-mirror
# Don't fire while the network is still coming up after boot/resume.
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Point both lines at the directory where you cloned git-dr-mirror.
# The tool reads its configuration from the .env file in this directory.
WorkingDirectory=%h/Projects/git-dr-mirror
ExecStart=%h/Projects/git-dr-mirror/.venv/bin/git-dr-mirror
# A backup should never make the machine you're working on feel slow.
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=default.target

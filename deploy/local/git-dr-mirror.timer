# git-dr-mirror — systemd USER timer (local workstation / laptop)
#
# Fires every 6 hours. Persistent=true is the important part for a machine
# that is not always on: if the computer was powered off (or suspended) when
# a run was due, the missed run fires once, shortly after the next boot —
# no runs pile up and nothing panics.

[Unit]
Description=Run git-dr-mirror every 6 hours

[Timer]
# Every 6 hours at :17 past the hour. Adjust freely, e.g.:
#   daily at 03:17      -> OnCalendar=*-*-* 03:17:00
#   every 2 hours       -> OnCalendar=00/2:17:00
OnCalendar=00/6:17:00
# Catch up on a run missed while powered off / asleep.
Persistent=true
# Spread the start a little so boot isn't a thundering herd.
RandomizedDelaySec=5m
Unit=git-dr-mirror.service

[Install]
WantedBy=timers.target
